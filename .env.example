# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Apify
APIFY_API_TOKEN=your_apify_api_token_here

# Apify Actor ID (default shown — override if you use a different actor)
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-job-search

# LinkedIn credentials (used for one-time manual login with session persistence)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Hotmail / Outlook (IMAP + SMTP)
# Use your account password. If two-factor auth is enabled, generate an App Password:
# account.microsoft.com → Security → App passwords
HOTMAIL_PASSWORD=your_hotmail_password_here

# Config path (optional override)
# CONFIG_PATH=C:/path/to/config.yaml
